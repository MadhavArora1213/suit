rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated (Admin)
    function isAdmin() {
      return request.auth != null;
    }

    // Products Collection
    // Anyone can view products, but only Admins can create/edit/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Settings Collection (Hero, Gallery, Lookbook, etc.)
    // Anyone can view the configuration, only Admins can change it
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews Collection
    // Anyone can view and create reviews, only Admins can update/delete
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Orders Collection
    // Customers can place orders (create), Admins can view and manage them
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Support Tickets (Contact Form)
    // Customers can create tickets, Admins can view and manage them
    match /contacts/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Fallback for any other collections not explicitly defined above
    // (Lock it down to Admin-only to prevent unauthorized access)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
