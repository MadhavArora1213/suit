rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products_overrides/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /boutiques/{boutiqueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collectionTags/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /festiveOffers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{docId} {
      allow read, write: if isAdmin();
    }

    match /waitlist/{emailId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /adminData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catch-all: everything else locked to admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
