rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products Overrides (ratings, review counts)
    match /products_overrides/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (hero, gallery, lookbook, categories, collections)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews (top-level collection)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Support Tickets (Contact Form)
    match /contacts/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Boutiques
    match /boutiques/{boutiqueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Waitlist (email signups)
    match /waitlist/{emailId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Admin Data (categories, collections, tags synced from admin panel)
    match /adminData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catch-all: everything else locked to admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
